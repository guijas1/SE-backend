SMARTAIR_API_PORT=8080
SMARTAIR_DASHBOARD_PORT=8501

# Cole a URL HTTPS completa do gatilho HTTP do Power Automate.
# Vazia = notificações desativadas. A URL contém uma chave: não publique.
SMARTAIR_POWER_AUTOMATE_URL=
SMARTAIR_DEVICE_NAME="SmartAir ESP32"
SMARTAIR_OFFLINE_AFTER_SECONDS=12
SMARTAIR_NOTIFICATION_CHECK_SECONDS=2
SMARTAIR_NOTIFICATION_TIMEOUT_SECONDS=10
# Bloqueia novas ativações de alertas já enviados por 5 minutos; 0 desativa.
SMARTAIR_ALERT_COOLDOWN_SECONDS=300
# 0 = somente mudanças; 3600 = também enviar um resumo a cada hora.
SMARTAIR_SUMMARY_INTERVAL_SECONDS=0
SMARTAIR_NOTIFICATION_TIMEZONE=America/Sao_Paulo
